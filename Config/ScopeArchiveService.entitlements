<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The archive service runs sandboxed with nothing granted: no files,
	     no network. It reads only the archive the app hands it, already open.
	     Keep it this way in every build, release included. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
