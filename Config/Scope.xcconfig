// "Scope": the real app. No sandbox. Until the MVP gate in the test plan is
// met it is read-only: the engine refuses every change. To allow changes, add
// SCOPE_ALLOW_WRITES to SWIFT_ACTIVE_COMPILATION_CONDITIONS below.
#include "Base.xcconfig"

PRODUCT_NAME = Scope
PRODUCT_BUNDLE_IDENTIFIER = com.antonispanos.scope
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
CODE_SIGN_ENTITLEMENTS = Config/Scope.entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS =
SWIFT_COMPILATION_MODE = wholemodule
SWIFT_OPTIMIZATION_LEVEL = -O
DEBUG_INFORMATION_FORMAT = dwarf-with-dsym

#include? "Local.xcconfig"
