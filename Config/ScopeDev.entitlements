<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Scope Dev runs sandboxed: it can reach its own container and the
	     test disks below, nothing else. Keep the list in sync with
	     BuildIdentity.testDiskRoots and scripts/testdisk.sh. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Print (Cmd+P) for PDFs, images and documents. -->
	<key>com.apple.security.print</key>
	<true/>
	<key>com.apple.security.temporary-exception.files.absolute-path.read-write</key>
	<array>
		<string>/Volumes/ScopeTest/</string>
		<string>/Volumes/ScopeTest2/</string>
		<string>/Volumes/ScopeTestCS/</string>
	</array>
</dict>
</plist>
