// Copy to Config/Local.xcconfig (ignored by git) to sign with your Apple ID's
// personal team. Find the team ID in Xcode > Settings > Accounts, or run:
//   security find-certificate -c "Apple Development" -p | openssl x509 -noout -subject
// and take the OU= value.
CODE_SIGN_IDENTITY = Apple Development
DEVELOPMENT_TEAM = YOURTEAMID
