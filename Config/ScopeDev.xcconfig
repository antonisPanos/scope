// "Scope Dev": the build used for all testing. No App Sandbox; its path guard
// lets it read anywhere and change files only in ~/ScopeScratch.
#include "Base.xcconfig"

PRODUCT_NAME = Scope Dev
PRODUCT_BUNDLE_IDENTIFIER = com.antonispanos.scope.dev
ASSETCATALOG_COMPILER_APPICON_NAME = AppIconDev
CODE_SIGN_ENTITLEMENTS = Config/ScopeDev.entitlements
SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG SCOPE_DEV
SWIFT_OPTIMIZATION_LEVEL = -Onone
ONLY_ACTIVE_ARCH = YES
DEBUG_INFORMATION_FORMAT = dwarf
ENABLE_TESTABILITY = YES
GCC_OPTIMIZATION_LEVEL = 0

#include? "Local.xcconfig"
