// Settings shared by every build of Scope.

MACOSX_DEPLOYMENT_TARGET = 27.2
SDKROOT = macosx
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
PRODUCT_MODULE_NAME = Scope
// Set by release-please from the conventional commits; tags are vX.Y.Z.
MARKETING_VERSION = 0.4.1 // x-release-please-version
// The build number is the commit count on main, stamped by scripts/release.sh.
// Local builds keep 1.
CURRENT_PROJECT_VERSION = 1

GENERATE_INFOPLIST_FILE = YES
INFOPLIST_KEY_NSPrincipalClass = NSApplication
INFOPLIST_KEY_LSApplicationCategoryType = public.app-category.productivity
INFOPLIST_KEY_NSHumanReadableCopyright = Personal build
ENABLE_HARDENED_RUNTIME = YES

// Reasons shown in the macOS prompts the first time Scope opens these places.
// Both builds reach them (neither is sandboxed).
INFOPLIST_KEY_NSDesktopFolderUsageDescription = Scope shows and manages the files on your Desktop.
INFOPLIST_KEY_NSDocumentsFolderUsageDescription = Scope shows and manages the files in your Documents folder.
INFOPLIST_KEY_NSDownloadsFolderUsageDescription = Scope shows and manages the files in your Downloads folder.
INFOPLIST_KEY_NSRemovableVolumesUsageDescription = Scope shows and manages the files on USB drives and SD cards.
INFOPLIST_KEY_NSNetworkVolumesUsageDescription = Scope shows and manages the files on network shares.
INFOPLIST_KEY_NSFileProviderDomainUsageDescription = Scope shows and manages files in iCloud Drive and other cloud folders.
COMBINE_HIDPI_IMAGES = YES

// Signing. Without Local.xcconfig the app is signed ad hoc ("Sign to Run
// Locally"), which is what CI uses. On your Mac, Local.xcconfig sets your
// personal team so macOS keeps the same identity between builds.
CODE_SIGN_STYLE = Manual
CODE_SIGN_IDENTITY = -
DEVELOPMENT_TEAM =
ALWAYS_SEARCH_USER_PATHS = NO
ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME = AccentColor
